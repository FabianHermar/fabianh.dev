---
import Container from '@/components/common/Container.astro'
import { sanitizeHtml } from '@/helpers/satinizeHTML'

import { getI18N } from '@/i18n'
import { getLangFromUrl, useTranslatedPath, useTranslations } from '@/i18n/utils'

const { currentLocale } = Astro
const i18n = getI18N({ currentLocale })

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
const translatePath = useTranslatedPath(lang)
---

<footer class='relative mt-20 border-t border-black/5 bg-[#fafafa] py-12 dark:border-white/6 dark:bg-[#050505]'>
	<!-- Top gradient line and subtle top glow -->
	<div class='absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-transparent via-[#b16cea]/30 to-transparent'></div>
	<div class='pointer-events-none absolute top-0 left-1/2 h-40 w-full max-w-3xl -translate-x-1/2 bg-[#b16cea]/5 blur-[80px] dark:bg-[#b16cea]/10'></div>

	<Container>
		<div class='relative z-10 flex flex-col items-center justify-between gap-12 lg:flex-row lg:items-start lg:gap-8'>
			<!-- Brand & Quote -->
			<div class='flex max-w-sm flex-col items-center text-center lg:items-start lg:text-left'>
				<a href='#' aria-label='Volver al inicio' class='group inline-block'>
					<h4 class='font-heading text-3xl font-bold tracking-tight text-black transition-colors dark:text-white'>
						Fabian Herrera<span class='text-[#b16cea] transition-colors group-hover:text-[#ff5e69]'>.</span>
					</h4>
				</a>
				<p class='font-accent mt-4 text-sm font-medium italic text-neutral-500 dark:text-[#737373]'>
					"Programa, aprende, falla, corrige y crece, una y otra vez."
				</p>
			</div>

			<!-- Navigation -->
			<div class='flex flex-col items-center gap-6 lg:items-end'>
				<ul class='font-display flex flex-wrap items-center justify-center gap-x-8 gap-y-4 text-sm font-medium text-neutral-600 dark:text-[#a3a3a3]'>
					<li>
						<a
							class='transition-colors duration-200 hover:text-[#b16cea] dark:hover:text-[#b16cea]'
							href={translatePath('/sobre-mi')}
						>
							{t('footer.about')}
						</a>
					</li>
					<li>
						<a
							class='transition-colors duration-200 hover:text-[#ff5e69] dark:hover:text-[#ff5e69]'
							href={translatePath('/blog')}
						>
							{t('footer.blog')}
						</a>
					</li>
					<li>
						<a
							class='transition-colors duration-200 hover:text-[#ffa84b] dark:hover:text-[#ffa84b]'
							href={translatePath('/proyectos')}
						>
							{t('footer.projects')}
						</a>
					</li>
					<li>
						<a
							class='transition-colors duration-200 hover:text-[#b16cea] dark:hover:text-[#b16cea]'
							href={translatePath('/guia-de-estilo')}
						>
							{t('footer.style')}
						</a>
					</li>
				</ul>

				<!-- Small text -->
				<div class='mt-2 flex items-center justify-center lg:justify-end'>
					<p
						class='font-accent max-w-lg text-balance text-center text-xs text-neutral-400 dark:text-[#525252] lg:text-right'
						set:html={sanitizeHtml(t('footer.small'))}
					/>
				</div>
			</div>
		</div>
	</Container>
</footer>
