---
import Container from '@/components/common/Container.astro'
import Contact from '@/components/contact/Contact.astro'
import GradualSpacing from '@/components/ui/gradual-spacing'

import { getI18N } from '@/i18n'

const { currentLocale } = Astro
const i18n = getI18N({ currentLocale })
---

<div id='contact' class='relative'>
	<!-- Decorative glow -->
	<div class='pointer-events-none absolute top-0 left-1/2 -translate-x-1/2 h-px w-96 bg-gradient-to-r from-transparent via-[#b16cea]/40 to-transparent'></div>

	<Container>
		<div class='mb-12 flex h-10 items-center justify-center pt-24'>
			<span class='section-number mr-3'>04</span>
			<GradualSpacing
				className='font-heading text-2xl font-bold text-black dark:text-white md:text-4xl'
				text={i18n.landing.contact.title}
				client:visible
			/>
			<span class='mt-1 ml-4 h-px grow bg-gradient-to-r from-black/10 to-transparent dark:from-white/20'></span>
		</div>
		<div class='pb-16'>
			<Contact />
		</div>
	</Container>
</div>
