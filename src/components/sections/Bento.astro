---
import { UTCClock } from '@/components/bento/Clock'
import Education from '@/components/bento/Education.astro'
import Hobbies from '@/components/bento/Hobbies.astro'
import CurrentWeather from '@/components/bento/Weather'
import WhoIAm from '@/components/bento/WhoIAm.astro'
import Container from '@/components/common/Container.astro'
import AnimatedSection from '@/components/ui/animated-section'
import GradualSpacing from '@/components/ui/gradual-spacing'
import { getI18N } from '@/i18n'
import { Image } from 'astro:assets'

const { currentLocale } = Astro
const i18n = getI18N({ currentLocale })
---

<Container>
	<div class='mb-12 flex h-10 items-center justify-center pt-24'>
		<span class='section-number mr-3'>03</span>
		<GradualSpacing
			className='font-heading text-2xl font-bold text-black dark:text-white md:text-4xl'
			text=`${i18n.landing.moreinfo.title}`
			client:visible
		/>
		<span class='mt-1 ml-4 h-px grow bg-gradient-to-r from-black/10 to-transparent dark:from-white/20'></span>
	</div>

	<WhoIAm />

	<AnimatedSection client:visible>
		<section class='bento-parent pt-8 pb-16'>

			<!-- Weather -->
			<article class='bento-weather bento-card'>
				<div class='flex items-center gap-x-3 px-5 pt-5 md:px-5 md:pt-5'>
					<Image
						class='h-8 w-8 select-none md:h-10 md:w-10'
						src='/svg/sun_3d.svg'
						alt='Weather'
						width={40}
						height={40}
					/>
					<h2 class='font-heading text-base font-bold text-black dark:text-white md:text-xl'>
						{i18n.landing.bento.weather.title}
					</h2>
				</div>
				<CurrentWeather client:visible />
			</article>

			<!-- Hobbies -->
			<article class='bento-hobbies bento-card'>
				<div class='flex items-center gap-x-3 px-5 pt-5 md:px-5 md:pt-5'>
					<Image
						class='h-8 w-8 select-none md:h-10 md:w-10'
						src='/svg/man_tech.svg'
						alt='Hobbies'
						width={40}
						height={40}
					/>
					<h2 class='font-heading text-base font-bold text-black dark:text-white md:text-xl'>Hobbies</h2>
				</div>
				<Hobbies />
			</article>

			<!-- Clock -->
			<article class='bento-time bento-card'>
				<div class='flex items-center gap-x-3 px-5 pt-5 md:mb-10 md:px-5 md:pt-5'>
					<Image
						class='h-8 w-8 select-none md:h-10 md:w-10'
						src='/svg/seven_oclock.svg'
						alt='Clock'
						width={40}
						height={40}
					/>
					<h2 class='font-heading text-base font-bold text-black dark:text-white md:text-xl'>
						{i18n.landing.bento.time.title}
					</h2>
				</div>
				<UTCClock client:visible currentLocale={currentLocale} />
			</article>

			<!-- Education -->
			<article class='bento-education bento-card'>
				<div class='flex items-center gap-x-3 px-5 pt-5 md:px-5 md:pt-5'>
					<Image
						class='h-8 w-8 select-none md:h-10 md:w-10'
						src='/svg/graduation_cap_3d.svg'
						alt='Graduation Cap'
						width={40}
						height={40}
					/>
					<h2 class='font-heading text-base font-bold text-black dark:text-white md:text-xl'>
						{i18n.landing.bento.education.title}
					</h2>
				</div>
				<Education />
			</article>

		</section>
	</AnimatedSection>
</Container>

<style>
	.bento-parent {
		display: grid;
		gap: 16px;
	}

	.bento-card {
		border-radius: 20px;
		border: 1px solid rgba(0, 0, 0, 0.05);
		background: rgba(0, 0, 0, 0.02);
		backdrop-filter: blur(12px);
		transition: border-color 0.3s ease, box-shadow 0.3s ease;
		overflow: hidden;
	}

	.bento-card:hover {
		border-color: rgba(0, 0, 0, 0.1);
	}

	:global(.dark) .bento-card {
		border-color: rgba(255, 255, 255, 0.06);
		background: rgba(255, 255, 255, 0.02);
	}

	:global(.dark) .bento-card:hover {
		border-color: rgba(255, 255, 255, 0.1);
	}

	.bento-weather {
		background: linear-gradient(135deg, rgba(177, 108, 234, 0.08) 0%, rgba(0, 0, 0, 0.02) 100%);
	}
	:global(.dark) .bento-weather {
		background: linear-gradient(135deg, rgba(177, 108, 234, 0.08) 0%, rgba(8, 8, 8, 0.6) 100%);
	}
	.bento-weather:hover {
		box-shadow: 0 0 30px rgba(177, 108, 234, 0.15);
	}
	:global(.dark) .bento-weather:hover {
		box-shadow: 0 0 30px rgba(177, 108, 234, 0.08);
	}

	.bento-hobbies {
		background: linear-gradient(135deg, rgba(255, 94, 105, 0.08) 0%, rgba(0, 0, 0, 0.02) 100%);
	}
	:global(.dark) .bento-hobbies {
		background: linear-gradient(135deg, rgba(255, 94, 105, 0.08) 0%, rgba(8, 8, 8, 0.6) 100%);
	}
	.bento-hobbies:hover {
		box-shadow: 0 0 30px rgba(255, 94, 105, 0.15);
	}
	:global(.dark) .bento-hobbies:hover {
		box-shadow: 0 0 30px rgba(255, 94, 105, 0.08);
	}

	.bento-time {
		background: linear-gradient(135deg, rgba(0, 0, 0, 0.03) 0%, rgba(0, 0, 0, 0.01) 100%);
	}
	:global(.dark) .bento-time {
		background: linear-gradient(135deg, rgba(15, 15, 15, 0.9) 0%, rgba(30, 30, 30, 0.5) 100%);
	}

	.bento-education {
		background: linear-gradient(135deg, rgba(255, 168, 75, 0.08) 0%, rgba(0, 0, 0, 0.02) 100%);
	}
	:global(.dark) .bento-education {
		background: linear-gradient(135deg, rgba(255, 168, 75, 0.08) 0%, rgba(8, 8, 8, 0.6) 100%);
	}
	.bento-education:hover {
		box-shadow: 0 0 30px rgba(255, 168, 75, 0.15);
	}
	:global(.dark) .bento-education:hover {
		box-shadow: 0 0 30px rgba(255, 168, 75, 0.08);
	}

	/* Mobile */
	@media screen and (max-width: 767px) {
		.bento-parent {
			grid-template-columns: 1fr;
			grid-template-rows: repeat(4, auto);
		}

		.bento-weather,
		.bento-hobbies,
		.bento-time,
		.bento-education {
			grid-area: auto;
		}
	}

	/* Desktop */
	@media screen and (min-width: 768px) {
		.bento-parent {
			grid-template-columns: repeat(5, 1fr);
			grid-template-rows: repeat(6, 1fr);
		}

		.bento-weather {
			grid-area: 1 / 1 / 4 / 3;
		}

		.bento-hobbies {
			grid-area: 1 / 3 / 4 / 6;
		}

		.bento-time {
			grid-area: 4 / 4 / 7 / 6;
		}

		.bento-education {
			grid-area: 4 / 1 / 7 / 4;
		}
	}
</style>
