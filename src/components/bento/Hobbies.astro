---
import { sanitizeHtml } from '@/helpers/satinizeHTML'
import { getI18N } from '@/i18n'

const { currentLocale } = Astro
const i18n = getI18N({ currentLocale })
---

<div class='prose max-w-full px-5 pt-4 pb-5'>
	<p class='font-accent text-sm text-neutral-600 dark:text-[#a3a3a3] leading-relaxed' set:html={sanitizeHtml(i18n.landing.bento.hobbies.fp)} />
	<p class='font-accent text-sm text-neutral-600 dark:text-[#a3a3a3] leading-relaxed mt-2' set:html={sanitizeHtml(i18n.landing.bento.hobbies.sp)} />
</div>
