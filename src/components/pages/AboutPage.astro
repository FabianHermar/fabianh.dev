---
import Container from '@/components/common/Container.astro'
import Layout from '@/layouts/Layout.astro'
import { getI18N } from '@/i18n'

const { currentLocale } = Astro
const i18n = getI18N({ currentLocale })
---

<Layout title={`${i18n.landing.moreinfo.who.title} | ${i18n.SEO.title}`}>
	<section class='relative min-h-screen pt-24 pb-32 overflow-hidden'>
		<Container>
            <div class="mx-auto max-w-6xl">
                
                <!-- Hero Section -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-16 mb-24 items-center">
                    <!-- Text Side -->
                    <div class="flex flex-col justify-center order-2 md:order-1 relative z-10">
                        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-black/5 dark:border-white/10 bg-black/5 dark:bg-white/5 w-fit mb-6">
                            <span class="relative flex h-2 w-2">
                                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#b16cea] opacity-75"></span>
                                <span class="relative inline-flex rounded-full h-2 w-2 bg-[#b16cea]"></span>
                            </span>
                            <span class="font-accent text-xs font-semibold tracking-wider text-neutral-600 dark:text-[#a3a3a3] uppercase">
                                {i18n.landing.moreinfo.who.title}
                            </span>
                        </div>
                        <h1 class="font-display mb-8 text-5xl font-bold tracking-tight text-black dark:text-white md:text-6xl lg:text-7xl">
                            {i18n.landing.moreinfo.title}
                        </h1>
                        <div class="font-accent text-lg text-neutral-600 dark:text-[#a3a3a3] space-y-6">
                            <p class="leading-relaxed">
                                {i18n.landing.moreinfo.who['1']}
                            </p>
                            <p class="leading-relaxed">
                                {i18n.landing.moreinfo.who['2'].fp} <strong class="text-black dark:text-white font-semibold">{i18n.landing.moreinfo.who['2'].sp}</strong>, 
                                <strong class="text-black dark:text-white font-semibold">{i18n.landing.moreinfo.who['2'].tp}</strong> {i18n.landing.moreinfo.who['2'].ftp} 
                                <strong class="text-black dark:text-white font-semibold">{i18n.landing.moreinfo.who['2'].ffp}</strong>
                            </p>
                            <p class="leading-relaxed italic border-l-2 border-[#b16cea] pl-4 mt-6">
                                {i18n.landing.moreinfo.who['3']}
                            </p>
                        </div>
                    </div>
                    <!-- Image Side -->
                    <div class="order-1 md:order-2 relative z-10">
                        <!-- Abstract glow behind image -->
                        <div class="absolute inset-0 -m-10 bg-gradient-to-tr from-[#b16cea]/20 via-[#ff5e69]/20 to-transparent blur-3xl rounded-full z-0 dark:opacity-30 opacity-50 pointer-events-none"></div>
                        <div class="relative w-full aspect-[4/5] md:aspect-[3/4] overflow-hidden rounded-[2.5rem] bg-white dark:bg-white/5 border border-black/5 dark:border-white/10 shadow-2xl shadow-neutral-200/50 dark:shadow-none z-10 transform transition-transform duration-700 hover:-translate-y-2">
                            <img 
                                src="/me.avif" 
                                alt="Fabián Hernández" 
                                class="absolute inset-0 h-full w-full object-cover"
                            />
                            <!-- Elegant inner shadow overlay -->
                            <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent pointer-events-none"></div>
                        </div>
                    </div>
                </div>

                <!-- Story Section (Staggered Layout) -->
                <div class="relative w-full mb-32">
                    <!-- Subtle connecting line (Desktop only) -->
                    <div class="hidden md:block absolute left-1/2 top-0 bottom-0 w-px bg-gradient-to-b from-transparent via-black/10 dark:via-white/10 to-transparent -translate-x-1/2"></div>
                    
                    <div class="flex flex-col gap-8 md:gap-16">
                        {i18n.landing.moreinfo.who.story?.map((paragraph: string, index: number) => (
                            <div class={`relative w-full md:w-3/4 lg:w-2/3 ${index % 2 === 0 ? 'md:ml-auto' : 'md:mr-auto'}`}>
                                <!-- Timeline node -->
                                <div class={`hidden md:flex absolute top-1/2 -translate-y-1/2 ${index % 2 === 0 ? '-left-10 lg:-left-20' : '-right-10 lg:-right-20'} w-8 h-8 items-center justify-center`}>
                                    <span class="absolute inline-flex h-full w-full rounded-full bg-black/5 dark:bg-white/10"></span>
                                    <span class="font-display text-xs text-neutral-400 dark:text-neutral-500">0{index + 1}</span>
                                </div>
                                
                                <div class="glass-card relative rounded-[2rem] border border-black/5 dark:border-white/10 bg-white/70 dark:bg-[#0f0f0f]/70 backdrop-blur-xl p-8 md:p-12 shadow-lg transition-all duration-500 hover:border-black/10 dark:hover:border-white/15 hover:shadow-xl hover:-translate-y-1">
                                    <!-- Subtle gradient top border -->
                                    <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-transparent via-[#b16cea]/50 to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100"></div>
                                    <p class="font-accent leading-loose text-lg text-neutral-700 dark:text-[#a3a3a3] text-pretty">
                                        {paragraph}
                                    </p>
                                </div>
                            </div>
                        ))}
                    </div>
                </div>

                <!-- Philosophy Section -->
                <div class="relative w-full mt-10 flex flex-col md:flex-row items-center gap-8 md:gap-12 py-10 md:py-16">
                    <div class="shrink-0 relative">
                        <!-- Subtle glow behind image -->
                        <div class="absolute inset-0 bg-gradient-to-tr from-[#b16cea] to-[#ff5e69] blur-2xl opacity-20 rounded-full"></div>
                        <img 
                            loading="lazy" 
                            src="/me2.avif" 
                            class="relative w-24 h-24 md:w-32 md:h-32 rounded-full object-cover border border-black/5 dark:border-white/10 shadow-lg transition-transform duration-500 hover:scale-105" 
                            alt="Fabián Hernández smiling" 
                        />
                    </div>
                    
                    <div class="relative flex-1 text-center md:text-left">
                        <svg class="absolute -top-6 -left-4 md:-top-8 md:-left-8 w-12 h-12 md:w-16 md:h-16 text-black/5 dark:text-white/5 pointer-events-none" fill="currentColor" viewBox="0 0 32 32" aria-hidden="true">
                            <path d="M9.352 4C4.456 7.456 1 13.12 1 19.36c0 5.088 3.072 8.064 6.624 8.064 3.36 0 5.856-2.688 5.856-5.856 0-3.168-2.208-5.472-5.088-5.472-.576 0-1.344.096-1.536.192.48-3.264 3.552-7.104 6.624-9.024L9.352 4zm16.512 0c-4.8 3.456-8.256 9.12-8.256 15.36 0 5.088 3.072 8.064 6.624 8.064 3.264 0 5.856-2.688 5.856-5.856 0-3.168-2.304-5.472-5.184-5.472-.576 0-1.248.096-1.44.192.48-3.264 3.456-7.104 6.528-9.024L25.864 4z"></path>
                        </svg>
                        <p class="font-accent text-xl md:text-3xl text-neutral-800 dark:text-[#e5e5e5] italic leading-relaxed md:leading-snug">
                            {i18n.landing.moreinfo.who.quote}
                        </p>
                    </div>
                </div>

            </div>
		</Container>
	</section>
</Layout>
